{
    "files.exclude": {
        "**/__pycache__": true,
        "**/.cache": true,
        "**/.pytest_cache": true,
        "**/node_modules": true,
        "**/.git": true,
        "**/.DS_Store": true,
        "**/.ruff_cache": true,
        "**/.venv": true,
        "**/*.egg-info": true,
    },
    "search.exclude": {
        "**/__pycache__": true,
        "**/.cache": true,
        "**/.pytest_cache": true,
        "**/node_modules": true,
        "**/.git": true,
        "**/.ruff_cache": true,
        "**/.venv": true,
        "**/*.egg-info": true,
    },
    "[python]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "always",
            "source.organizeImports.ruff": "always"
        }
    },
    "ruff.path": [
        "uvx",
        "ruff"
    ],
    "git.ignoreLimitWarning": true,
    "terminal.integrated.env.linux": {
        "PYTHONPYCACHEPREFIX": "/tmp/reveng-python-cache",
        "XDG_CACHE_HOME": "/tmp/reveng-runtime-cache"
    }
}
